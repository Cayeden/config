// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "custom/vpn",
        "network",
        "pulseaudio",
        "custom/cpu",
        "custom/nvidia-gpu",
        "memory",
        "disk",
        "clock",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "hyprland/submap": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },
    "custom/vpn": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/vpn-status.sh",
        "on-click": "$HOME/.config/waybar/scripts/vpn-toggle.sh",
        "interval": 5,
        "tooltip": true
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) — {ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname} — {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty -e nmtui"
    },

    "pulseaudio": {
        "format": " {volume}%",
        "format-muted": " muted",
        "on-click": "pavucontrol"
    },

    "custom/cpu": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/cpu-status.sh",
        "interval": 2,
        "on-click": "kitty -e btop"
    },
    "custom/nvidia-gpu": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.config/waybar/scripts/gpu-status.sh",
        "interval": 2,
        "on-click": "kitty -e nvidia-smi -l 1"
    },
    "memory": {
        "format": "󰍛 {}%",
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)\n4× 16GB DDR4-3600 (dual channel)",
        "on-click": "kitty -e btop"
    },
    "disk": {
        "path": "/mnt/storage",
        "format": "{percentage_used}% used",
        "tooltip-format": "{path}: {used} / {total} ({percentage_used}%)"
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "spacing": 10
    }
}
